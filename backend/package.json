{
  "name": "pharmacy-inventory-api",
  "version": "1.0.0",
  "description": "Pharmacy Inventory API with strict business rules and concurrency control",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:up": "node-pg-migrate up --envPath .env",
    "migrate:down": "node-pg-migrate down --envPath .env",
    "seed": "node seeds/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "node-pg-migrate": "7.9.1",
    "pg": "8.13.3",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prom-client": "^15.1.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "eslint": "9.21.0",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.5.2",
    "supertest": "7.0.0"
  }
}
