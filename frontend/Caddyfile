# Caddyfile — Reverse Proxy and Static File Server for Local & Cloud Deployments
{
    local_certs
}

# Serve both HTTP (:80) and HTTPS (:443) seamlessly for public IPs and domains
:80, :443, localhost {
    tls internal

    root * /srv
    encode gzip zstd
    file_server

    # Production-ready Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Reverse proxy API and Observability endpoints to backend service
    handle /api/* {
        reverse_proxy {$API_HOST:api}:{$API_PORT:3000}
    }

    handle /health {
        reverse_proxy {$API_HOST:api}:{$API_PORT:3000}
    }

    handle /ready {
        reverse_proxy {$API_HOST:api}:{$API_PORT:3000}
    }

    handle /metrics {
        reverse_proxy {$API_HOST:api}:{$API_PORT:3000}
    }

    # SPA routing fallback for client-side navigation
    handle {
        try_files {path} /index.html
    }
}
